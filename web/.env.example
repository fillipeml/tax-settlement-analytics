# --- Web app (Next.js) ---------------------------------------------------------
# Demo mode: visitors are signed in automatically as "Demo user" and the pair demo / demo is
# accepted. Set to "false" (or remove) for a real deployment.
DEMO_MODE=true

# Secret used to sign the session cookie (HMAC-SHA256). Required outside demo mode.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Accounts, option A: a JSON list of users with the SHA-256 hex digest of each password.
#   printf 'my-password' | sha256sum
# APP_USERS=[{"user":"ana","name":"Ana Example","sha256":"<hex digest>"}]

# Accounts, option B (single shared login, used when APP_USERS is not set):
# SHARED_USER=team
# SHARED_PASSWORD=
